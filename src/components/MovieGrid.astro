---
import { movies } from "../data/movies.js";
import MovieCard from "./MovieCard.astro";
---

<section class="catalog" id="peliculas">
    <div class="section-header">
        <small>Catálogo</small>
        <h2>Películas</h2>
    </div>
    <div class="filters">
        <input type="text" id="movie-search" placeholder="Buscar película..." aria-label="Buscar película"/>
        <select id="genre-filter" aria-label="Filtrar por género">
            <option value="all">Todos los géneros</option>
            <option value="Acción">Acción</option>
            <option value="Aventura">Aventura</option>
            <option value="Ciencia ficción">Ciencia ficción</option>
        </select>
        <select id="year-filter" aria-label="Filtrar por año">
            <option value="all">Todos los años</option>
            <option value="2008">2008</option>
            <option value="2010">2010</option>
            <option value="2011">2011</option>
            <option value="2012">2012</option>
            <option value="2013">2013</option>
            <option value="2014">2014</option>
            <option value="2015">2015</option>
            <option value="2016">2016</option>
            <option value="2017">2017</option>
            <option value="2018">2018</option>
            <option value="2019">2019</option>
        </select>
        <button id="clear-filters" type="button">Limpiar</button>
    </div>
    <div class="movie-grid" id="movie-grid">
        {movies.map((movie) => (
                <MovieCard movie={movie} />
            ))}
    </div>
    <div class="no-results" id="no-results">
        <h3>No encontramos películas</h3>
        <p>Probá con otra búsqueda o cambiá los filtros.</p>
    </div>
</section>
<script>
    function filterMovies() {
        const searchInput = document.querySelector("#movie-search");
        const genreFilter = document.querySelector("#genre-filter");
        const yearFilter = document.querySelector("#year-filter");
        const noResults = document.querySelector("#no-results");
        const movieCards = document.querySelectorAll("#movie-grid .movie-card");
        const search = searchInput?.value.toLowerCase().trim() ?? "";
        const selectedGenre = genreFilter?.value ?? "all";
        const selectedYear = yearFilter?.value ?? "all";
        let visibleMovies = 0;
        movieCards.forEach((card) => {
            const name = card.dataset.name ?? "";
            const genre = card.dataset.genre ?? "";
            const year = card.dataset.year ?? "";
            const matchesSearch = name.includes(search);
            const matchesGenre = selectedGenre === "all" || genre === selectedGenre;
            const matchesYear = selectedYear === "all" || year === selectedYear;
            const shouldShow = matchesSearch && matchesGenre && matchesYear;

            card.style.display = shouldShow ? "" : "none";
            if (shouldShow) {
                visibleMovies++;
            }
        });

        if (noResults) {
            noResults.style.display = visibleMovies === 0 ? "block" : "none";
        }
    }

    function clearFilters() {
        const searchInput = document.querySelector("#movie-search");
        const genreFilter = document.querySelector("#genre-filter");
        const yearFilter = document.querySelector("#year-filter");

        if (searchInput) {
            searchInput.value = "";
        }

        if (genreFilter) {
            genreFilter.value = "all";
        }

        if (yearFilter) {
            yearFilter.value = "all";
        }
        filterMovies();
    }

    document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.querySelector("#movie-search");
            const genreFilter = document.querySelector("#genre-filter");
            const yearFilter = document.querySelector("#year-filter");
            const clearButton = document.querySelector("#clear-filters");

            searchInput?.addEventListener("input", filterMovies);
            genreFilter?.addEventListener("change", filterMovies);
            yearFilter?.addEventListener("change", filterMovies);
            clearButton?.addEventListener("click", clearFilters);
        }
    );
</script>
<style>
    .catalog {
        padding: 80px 6%;
    }

    .section-header {
        margin-bottom: 35px;
    }

    .section-header small {
        color: #e62429;
        font-size: 0.8rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .section-header h2 {
        margin-top: 8px;
        color: #ffffff;
        font-size: 2.5rem;
    }

    .filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 15px;
        margin-bottom: 40px;
    }

    .filters input, .filters select, .filters button {
        width: 100%;
        padding: 13px 15px;
        border: 1px solid #303039;
        border-radius: 6px;
        background: #15151b;
        color: #ffffff;
        outline: none;
    }

    .filters input:focus, .filters select:focus {
        border-color: #e62429;
    }

    .filters button {
        width: auto;
        border-color: #e62429;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .filters button:hover {
        background: #e62429;
        color: #ffffff;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .no-results {
        display: none;
        padding: 60px 20px;
        text-align: center;
    }

    .no-results h3 {
        margin-bottom: 10px;
    }

    .no-results p {
        color: #9999a3;
    }

    @media (max-width: 1000px) {
        .movie-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .filters button {
            width: 100%;
        }
    }

    @media (max-width: 700px) {
        .catalog {
            padding: 60px 5%;
        }

        .filters {
            grid-template-columns: 1fr;
        }

        .movie-grid {
            grid-template-columns: repeat(2, 1fr);

            gap: 15px;
        }
    }

    @media (max-width: 450px) {
        .movie-grid {
            grid-template-columns: 1fr;
        }
    }
</style>